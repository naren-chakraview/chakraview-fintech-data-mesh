@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix fintech: <https://chakracommerce.com/ontology/fintech/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# Risk/Compliance domain output. RiskProfile is owned here; Customer is not.

fintech:RiskProfileShape
  a sh:NodeShape ;
  sh:targetClass fintech:RiskProfile ;
  sh:property [
    sh:path fintech:riskProfileId ; sh:minCount 1 ;
  ] ;
  sh:property [
    sh:path fintech:riskScore ; sh:minCount 1 ; sh:datatype xsd:decimal ;
    sh:message "riskScore must be xsd:decimal."
  ] ;
  sh:property [
    sh:path fintech:fraudFlagsCount ; sh:datatype xsd:integer ;
  ] ;
  sh:property [
    sh:path fintech:forCustomer ; sh:minCount 1 ; sh:maxCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:pattern "^https://chakracommerce.com/customer#[0-9a-f]{64}$" ;
    sh:message "forCustomer must point at a Customer IRI minted by the identity library."
  ] .
