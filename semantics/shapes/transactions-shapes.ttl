@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix fintech: <https://chakracommerce.com/ontology/fintech/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# Transactions domain output. Transaction and Counterparty are owned here.

fintech:TransactionShape
  a sh:NodeShape ;
  sh:targetClass fintech:Transaction ;
  sh:property [
    sh:path fintech:transactionId ; sh:minCount 1 ;
  ] ;
  sh:property [
    sh:path fintech:transactionAmount ; sh:minCount 1 ; sh:datatype xsd:decimal ;
    sh:message "transactionAmount must be xsd:decimal (not float, not fintech:decimal)."
  ] ;
  sh:property [
    sh:path fintech:transactionDate ; sh:datatype xsd:dateTime ;
  ] ;
  sh:property [
    sh:path fintech:transactionDebtor ; sh:minCount 1 ; sh:maxCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:pattern "^https://chakracommerce.com/customer#[0-9a-f]{64}$" ;
    sh:message "transactionDebtor must point at a Customer IRI minted by the identity library."
  ] .
